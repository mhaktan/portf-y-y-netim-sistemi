[
  {
    "id": "flow-ManagerTarget-approval",
    "name": "ManagerTarget Approval Flow",
    "description": "Auto-generated approval flow for ManagerTarget. Customize email templates and add conditions as needed.",
    "resourceName": "ManagerTarget",
    "enabled": true,
    "variables": [
      {
        "name": "assigneeEmail",
        "type": "string",
        "defaultValue": ""
      },
      {
        "name": "creatorEmail",
        "type": "string",
        "defaultValue": ""
      },
      {
        "name": "departmentEmails",
        "type": "string",
        "defaultValue": ""
      },
      {
        "name": "formLink",
        "type": "string",
        "defaultValue": ""
      }
    ],
    "nodes": [
      {
        "id": "ManagerTarget-approval-trigger",
        "type": "trigger",
        "label": "On ManagerTarget Submit",
        "position": {
          "x": 300,
          "y": 50
        },
        "trigger": {
          "type": "on-field-change",
          "resourceName": "ManagerTarget",
          "fieldName": "status"
        }
      },
      {
        "id": "ManagerTarget-approval-condition",
        "type": "condition",
        "label": "Status = PendingApproval?",
        "position": {
          "x": 300,
          "y": 160
        },
        "condition": {
          "logic": "and",
          "rules": [
            {
              "field": "triggerData.status",
              "operator": "equals",
              "value": "1"
            }
          ]
        }
      },
      {
        "id": "ManagerTarget-approval-approval",
        "type": "approval",
        "label": "ManagerTarget Approval",
        "position": {
          "x": 300,
          "y": 280
        },
        "approval": {
          "steps": [
            {
              "name": "Şube Müdürü Onayı",
              "assigneeType": "role",
              "assigneeValue": "BranchManager",
              "actions": [
                {
                  "label": "Onayla",
                  "type": "approve"
                },
                {
                  "label": "Revize Et",
                  "type": "revise",
                  "requiredFields": [
                    "revisionNote"
                  ]
                }
              ]
            }
          ],
          "trackRevisionHistory": true,
          "onCompleteEvent": "ManagerTarget-approval-completed"
        }
      },
      {
        "id": "ManagerTarget-approval-email",
        "type": "action",
        "label": "Send Approval Email",
        "position": {
          "x": 300,
          "y": 400
        },
        "action": {
          "type": "send-email",
          "config": {
            "to": "{{assigneeEmail}}",
            "subject": "{{triggerData.description}} — Hedef Onayınızı Bekliyor",
            "body": "<p>Sayın Şube Müdürü,</p><p><strong>{{triggerData.description}}</strong> hedefi onayınızı beklemektedir.</p>",
            "contentType": "html"
          }
        }
      },
      {
        "id": "ManagerTarget-approval-completion-trigger",
        "type": "trigger",
        "label": "On ManagerTarget Approved",
        "position": {
          "x": 700,
          "y": 50
        },
        "trigger": {
          "type": "manual",
          "resourceName": "ManagerTarget"
        }
      },
      {
        "id": "ManagerTarget-approval-completion-email",
        "type": "action",
        "label": "Send Completion Email",
        "position": {
          "x": 700,
          "y": 160
        },
        "action": {
          "type": "send-email",
          "config": {
            "to": "{{creatorEmail}}",
            "cc": "{{departmentEmails}}",
            "subject": "{{triggerData.formNo}} — Tum onaylar tamamlandi",
            "body": "<p>{{triggerData.formNo}} numarali formun onay sureci tamamlanmistir.</p>",
            "contentType": "html"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "gen_1793289272656_13",
        "sourceNodeId": "ManagerTarget-approval-trigger",
        "targetNodeId": "ManagerTarget-approval-condition"
      },
      {
        "id": "gen_1793289272656_14",
        "sourceNodeId": "ManagerTarget-approval-condition",
        "targetNodeId": "ManagerTarget-approval-approval",
        "branch": "true"
      },
      {
        "id": "gen_1793289272656_15",
        "sourceNodeId": "ManagerTarget-approval-approval",
        "targetNodeId": "ManagerTarget-approval-email"
      },
      {
        "id": "gen_1793289272656_16",
        "sourceNodeId": "ManagerTarget-approval-completion-trigger",
        "targetNodeId": "ManagerTarget-approval-completion-email"
      }
    ],
    "createdAt": "2026-10-29T15:54:32.656Z",
    "updatedAt": "2026-10-29T15:54:32.656Z"
  },
